{
  "name": "manticollect",
  "productName": "MantiCollect",
  "version": "0.1.0",
  "description": "MantiCollect — A Mantitup Product. Local-first universal media downloader and digital collector for Windows.",
  "main": "electron/main.js",
  "type": "module",
  "license": "MIT",
  "private": true,
  "author": "Mantitup",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "concurrently -k -n RENDERER,MAIN -c cyan,yellow \"next dev -p 3000\" \"wait-on tcp:127.0.0.1:3000 && cross-env NEXT_DEV_SERVER_URL=http://127.0.0.1:3000 electron .\"",
    "build": "next build",
    "start": "npm run build && electron .",
    "dist": "npm run build && node scripts/clean-release.mjs && electron-builder --win",
    "generate-icons": "node scripts/generate-icons.mjs",
    "package:extension": "node scripts/package-extension.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "smoke": "node scripts/smoke.mjs",
    "setup-bins": "node scripts/setup-bins.mjs"
  },
  "build": {
    "appId": "com.mantitup.manticollect",
    "productName": "MantiCollect",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "src/lib/csp.js",
      "public/**",
      "package.json",
      "!**/*.test.*",
      "!**/*.spec.*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,test,tests,example,examples}",
      "!**/node_modules/.bin"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/ffmpeg-static/**",
      "**/ffprobe-static/**"
    ],
    "extraResources": [
      {
        "from": "vendor",
        "to": "vendor",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/assets/icon.ico",
      "artifactName": "MantiCollect-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "MantiCollect",
      "installerIcon": "electron/assets/icon.ico",
      "uninstallerIcon": "electron/assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "saikattanti",
        "repo": "MantiCollect"
      }
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.0.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "postcss": "^8.5.31",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "wait-on": "^9.5.1"
  }
}
